@startuml
skinparam defaultFontName IPAGothic
title レブリミッタ / カット開始は 6500 rpm 以上 [2] rpm=6500, state=ON
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 50 as s0
analog "エンジン回転数 [rpm]" between 0 and 6500 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 50
s1 is 6500
@10
s0 is 50
s1 is 6500
s2 is high
highlight 10 to 20 #Gold;line:DimGrey : 確認
@enduml
