@startuml
skinparam defaultFontName IPAGothic
title レブリミッタ / カット中は 6300 rpm 以下になるまで継続する [1] rpm=6301, state=ON
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 50 as s0
analog "エンジン回転数 [rpm]" between 6301 and 7000 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 50
s1 is 7000
@9
s1 is 7000
@10
s1 is 6301
@20
s0 is 50
s1 is 6301
s2 is high
highlight 20 to 30 #Gold;line:DimGrey : 確認
@enduml
