@startuml
skinparam defaultFontName IPAGothic
title レブリミッタ / 上限 6500 rpm でカットし、復帰 6300 rpm まで下がると復帰する  @代表動作
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 50 as s0
analog "エンジン回転数 [rpm]" between 6000 and 6500 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 50
s1 is 6000
@9
s1 is 6000
@10
s1 is 6500
s2 is low
@19
s1 is 6500
@20
s1 is 6400
s2 is high
@29
s1 is 6400
@30
s1 is 6300
s2 is high
@40
s0 is 50
s1 is 6300
s2 is low
highlight 10 to 20 #Gold;line:DimGrey : 確認
highlight 20 to 30 #Gold;line:DimGrey : 確認
highlight 30 to 40 #Gold;line:DimGrey : 確認
highlight 40 to 50 #Gold;line:DimGrey : 確認
@enduml
