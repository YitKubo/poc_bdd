@startuml
skinparam defaultFontName IPAGothic
title レブリミッタ / カット開始は 6500 rpm 以上 [1] rpm=6499, state=OFF
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 50 as s0
analog "エンジン回転数 [rpm]" between 0 and 6499 as s1
