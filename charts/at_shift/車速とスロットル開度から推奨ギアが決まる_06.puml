@startuml
skinparam defaultFontName IPAGothic
title AT 変速判定 / 車速とスロットル開度から推奨ギアが決まる [6] speed=59, throttle=10, gear=3
scale 12 as 700 pixels
legend left
  ECUが初期化されている
endlegend
concise "車速" as s0
concise "スロットル開度" as s1
concise "推奨ギア (期待)" as s2

@0
s0 is "59 km/h"
s1 is "10 %"
s2 is "?"
@10
s2 is "3 速"
@12
highlight 10 to 11 #FFD70066;line:DimGrey : 確認
@enduml
