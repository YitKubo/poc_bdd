@startuml
skinparam defaultFontName IPAGothic
title 減速時燃料カット / カット開始条件（全閉 2 % 以下かつ 1500 rpm 超え） [4] throttle=3, rpm=3000, state=OFF
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 3 as s0
analog "エンジン回転数 [rpm]" between 0 and 3000 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 3
s1 is 3000
@10
s0 is 3
s1 is 3000
s2 is low
highlight 10 to 20 #Gold;line:DimGrey : 確認
@enduml
