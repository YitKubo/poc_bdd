@startuml
skinparam defaultFontName IPAGothic
title 減速時燃料カット / カット中は 1100 rpm 以下になるまで継続する [2] rpm=1100, state=OFF
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between -1 and 1 as s0
analog "エンジン回転数 [rpm]" between 1100 and 3000 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 0
s1 is 3000
@9
s1 is 3000
@10
s1 is 1100
@20
s0 is 0
s1 is 1100
s2 is low
highlight 20 to 30 #Gold;line:DimGrey : 確認
@enduml
