@startuml
skinparam defaultFontName IPAGothic
title 減速時燃料カット / カット中は 1100 rpm 以下になるまで継続する [2] rpm=1100, state=OFF
scale 22 as 700 pixels
legend left
  ECUが初期化されている
endlegend
concise "スロットル開度" as s0
analog "エンジン回転数 [rpm]" between 1100 and 3000 as s1
concise "燃料カット (期待)" as s2

@0
s0 is "0 %"
s1 is 3000
s2 is "?"
@10
s1 is 3000
s2 is "ON"
@11
s1 is 1100
@20
s2 is "OFF"
@22
s1 is 1100
@22
highlight 10 to 11 #FFD70066;line:DimGrey : 確認
highlight 20 to 21 #FFD70066;line:DimGrey : 確認
@enduml
