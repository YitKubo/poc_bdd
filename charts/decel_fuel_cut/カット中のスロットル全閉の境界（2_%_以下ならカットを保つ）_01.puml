@startuml
skinparam defaultFontName IPAGothic
title 減速時燃料カット / カット中のスロットル全閉の境界（2 % 以下ならカットを保つ） [1] throttle=1, state=ON
scale 22 as 700 pixels
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 1 as s0
concise "エンジン回転数" as s1
concise "燃料カット (期待)" as s2

@0
s0 is 0
s1 is "3000 rpm"
s2 is "?"
@10
s0 is 0
s2 is "ON"
@11
s0 is 1
@20
s2 is "ON"
@22
s0 is 1
@22
highlight 10 to 11 #FFD70066;line:DimGrey : 確認
highlight 20 to 21 #FFD70066;line:DimGrey : 確認
@enduml
