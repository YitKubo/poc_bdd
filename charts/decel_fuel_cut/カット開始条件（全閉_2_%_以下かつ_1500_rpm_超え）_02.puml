@startuml
skinparam defaultFontName IPAGothic
title 減速時燃料カット / カット開始条件（全閉 2 % 以下かつ 1500 rpm 超え） [2] throttle=0, rpm=1501, state=ON
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between -1 and 1 as s0
analog "エンジン回転数 [rpm]" between 0 and 1501 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 0
s1 is 1501
@10
s0 is 0
s1 is 1501
s2 is high
highlight 10 to 20 #Gold;line:DimGrey : 確認
@enduml
