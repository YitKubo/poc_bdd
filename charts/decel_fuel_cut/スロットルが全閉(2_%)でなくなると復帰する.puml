@startuml
skinparam defaultFontName IPAGothic
title 減速時燃料カット / スロットルが全閉(2 %)でなくなると復帰する
legend left
  ECUが初期化されている
endlegend
analog "スロットル開度 [%]" between 0 and 10 as s0
analog "エンジン回転数 [rpm]" between 0 and 3000 as s1
binary "燃料カット (期待)" as s2

@0
s0 is 0
s1 is 3000
@9
s0 is 0
@10
s0 is 10
@20
s0 is 10
s1 is 3000
s2 is low
highlight 20 to 30 #Gold;line:DimGrey : 確認
@enduml
