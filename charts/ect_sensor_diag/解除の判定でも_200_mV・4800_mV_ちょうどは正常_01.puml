@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 解除の判定でも 200 mV・4800 mV ちょうどは正常 [1] mv=199, dtc=P0117
scale 1040 as 700 pixels
legend left
  ECUが初期化されている
endlegend
analog "水温センサ電圧 [mV]" between 100 and 199 as s0
concise "確定DTC (期待)" as s1

@0
s0 is 100
s1 is "?"
@490
s0 is 100
@500
s0 is 199
@1000
s1 is "P0117"
@1040
s0 is 199
@1040
highlight 1000 to 1020 #FFD70066;line:DimGrey : 確認
@enduml
