@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 正常に戻って 500 ms 続くと DTC が解除される [4] fault=4900, fault_dtc=P0118, ms=500, dtc=なし
scale 1040 as 700 pixels
legend left
  ECUが初期化されている
endlegend
analog "水温センサ電圧 [mV]" between 2000 and 4900 as s0
concise "確定DTC (期待)" as s1

@0
s0 is 4900
s1 is "?"
@499
s0 is 4900
@500
s1 is "P0118"
@509
s0 is 2000
@1000
s1 is "なし"
@1040
s0 is 2000
@1040
highlight 500 to 520 #FFD70066;line:DimGrey : 確認
highlight 1000 to 1020 #FFD70066;line:DimGrey : 確認
@enduml
