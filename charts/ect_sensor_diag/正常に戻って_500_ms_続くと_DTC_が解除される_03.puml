@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 正常に戻って 500 ms 続くと DTC が解除される [3] fault=4900, fault_dtc=P0118, ms=490, dtc=P0118
scale 1028 as 700 pixels
legend left
  ECUが初期化されている
endlegend
analog "水温センサ電圧 [mV]" between 2000 and 4900 as s0
concise "確定DTC (期待)" as s1

@0
s0 is 4900
s1 is "?"
@500
s0 is 4900
s1 is "P0118"
@509
s0 is 2000
@990
s1 is "P0118"
@1028
s0 is 2000
@1028
highlight 500 to 519 #FFD70066;line:DimGrey : 確認
highlight 990 to 1009 #FFD70066;line:DimGrey : 確認
@enduml
