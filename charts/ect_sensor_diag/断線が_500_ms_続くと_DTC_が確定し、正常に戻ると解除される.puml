@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 断線が 500 ms 続くと DTC が確定し、正常に戻ると解除される  @代表動作
scale 1144 as 700 pixels
legend left
  ECUが初期化されている
endlegend
concise "水温" as s0
analog "水温センサ電圧 [mV]" between 100 and 2000 as s1
concise "確定DTC (期待)" as s2
concise "制御用水温 (期待)" as s3

@0
s0 is "30 ℃"
s1 is 2000
s2 is "?"
s3 is "?"
@98
s1 is 2000
@100
s2 is "なし"
s3 is "30 ℃"
@109
s1 is 100
@590
s2 is "なし"
@598
s1 is 100
@600
s2 is "P0117"
s3 is "80 ℃"
@609
s1 is 2000
@1100
s2 is "なし"
s3 is "30 ℃"
@1144
s1 is 2000
@1144
highlight 100 to 122 #FFD70066;line:DimGrey : 確認
highlight 590 to 612 #FFD70066;line:DimGrey : 確認
highlight 600 to 622 #FFD70066;line:DimGrey : 確認
highlight 1100 to 1122 #FFD70066;line:DimGrey : 確認
@enduml
