@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 正常に戻って 500 ms 続くと DTC が解除される [2] fault=100, ms=500, dtc=なし
scale 1040 as 700 pixels
legend left
  ECUが初期化されている
endlegend
analog "水温センサ電圧 [mV]" between 100 and 2000 as s0
concise "確定DTC (期待)" as s1

@0
s0 is 100
s1 is "?"
@490
s0 is 100
@500
s0 is 2000
@1000
s1 is "なし"
@1040
s0 is 2000
@1040
highlight 1000 to 1020 #FFD70066;line:DimGrey : 確認
@enduml
