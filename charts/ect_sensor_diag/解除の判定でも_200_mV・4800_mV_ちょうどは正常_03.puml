@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 解除の判定でも 200 mV・4800 mV ちょうどは正常 [3] mv=4800, dtc=なし
scale 1040 as 700 pixels
legend left
  ECUが初期化されている
endlegend
analog "水温センサ電圧 [mV]" between 100 and 4800 as s0
concise "確定DTC (期待)" as s1

@0
s0 is 100
s1 is "?"
@490
s0 is 100
@500
s0 is 4800
@1000
s1 is "なし"
@1040
s0 is 4800
@1040
highlight 1000 to 1020 #FFD70066;line:DimGrey : 確認
@enduml
