@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 電圧が 200 mV 未満／4800 mV 超えで 500 ms 続くと DTC が確定する [7] mv=4900, ms=490, dtc=なし
scale 508 as 700 pixels
legend left
  ECUが初期化されている
endlegend
concise "水温センサ電圧" as s0
concise "確定DTC (期待)" as s1

@0
s0 is "4900 mV"
s1 is "?"
@490
s1 is "なし"
@508
highlight 490 to 499 #FFD70066;line:DimGrey : 確認
@enduml
