@startuml
skinparam defaultFontName IPAGothic
title 水温センサ故障検出 / 電圧が 200 mV 未満／4800 mV 超えで 500 ms 続くと DTC が確定する [4] mv=200, ms=500, dtc=なし
legend left
  ECUが初期化されている
endlegend
analog "水温センサ電圧 [mV]" between 0 and 200 as s0
concise "確定DTC (期待)" as s1

@0
s0 is 200
s1 is "?"
@500
s0 is 200
s1 is "なし"
highlight 500 to 510 #Gold;line:DimGrey : 確認
@enduml
