@startuml
skinparam defaultFontName IPAGothic
title アイドル回転数制御 / 水温から目標アイドル回転数が決まる [2] temp=19, idle=1200
legend left
  ECUが初期化されている
endlegend
analog "水温 [℃]" between 0 and 19 as s0
analog "目標アイドル回転数 (期待) [rpm]" between 0 and 1200 as s1

@0
s0 is 19
@10
s0 is 19
s1 is 1200
highlight 10 to 20 #Gold;line:DimGrey : 確認
@enduml
