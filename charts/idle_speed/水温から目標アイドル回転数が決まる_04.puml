@startuml
skinparam defaultFontName IPAGothic
title アイドル回転数制御 / 水温から目標アイドル回転数が決まる [4] temp=59, idle=1000
scale 12 as 700 pixels
legend left
  ECUが初期化されている
endlegend
concise "水温" as s0
concise "目標アイドル回転数 (期待)" as s1

@0
s0 is "59 ℃"
s1 is "?"
@10
s1 is "1000 rpm"
@12
highlight 10 to 11 #FFD70066;line:DimGrey : 確認
@enduml
