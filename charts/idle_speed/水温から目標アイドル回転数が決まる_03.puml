@startuml
skinparam defaultFontName IPAGothic
title アイドル回転数制御 / 水温から目標アイドル回転数が決まる [3] temp=20, idle=1000
legend left
  ECUが初期化されている
endlegend
analog "水温 [℃]" between 0 and 20 as s0
analog "目標アイドル回転数 (期待) [rpm]" between 0 and 1000 as s1

@0
s0 is 20
@10
s0 is 20
s1 is 1000
highlight 10 to 20 #Gold;line:DimGrey : 確認
@enduml
